# Environment / secrets — NEVER commit these
.env
*.env.local
service-account*.json
*-key.json
*credentials*.json

# Python
venv/
env/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Node / frontend (if dashboard uses npm)
node_modules/
dist/
build/
.next/

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

